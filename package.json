{
  "name": "altteuri",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tools/tests/**/*.test.mjs",
    "test:extension": "node --test tools/tests/extension/*.mjs",
    "test:web": "node --test tools/tests/web/*.test.mjs",
    "test:e2e": "node --test tools/tests/e2e/*.test.mjs",
    "generate:extension-lib": "node tools/scripts/generate-extension-lib.mjs",
    "generate:legal": "node tools/scripts/generate-legal.mjs",
    "generate:sfx": "node tools/scripts/generate-sfx.mjs",
    "generate": "npm run generate:extension-lib && npm run generate:legal",
    "sync:assets": "node tools/scripts/sync-assets.mjs",
    "sync:public-meta": "node tools/scripts/sync-public-meta.mjs",
    "sync:intro": "node tools/scripts/sync-intro-video.mjs",
    "build:extension": "node tools/scripts/build-extension-zip.mjs",
    "release:check": "node tools/scripts/release.mjs --check",
    "lint": "eslint apps/extension apps/web/api apps/web/lib tools --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^17.8.0"
  }
}
