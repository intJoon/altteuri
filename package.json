{
  "name": "altteuri",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test tools/tests/**/*.test.mjs",
    "test:extension": "node --test tools/tests/extension/*.mjs",
    "test:web": "node --test tools/tests/web/*.test.mjs",
    "test:e2e": "node --test tools/tests/e2e/*.test.mjs",
    "generate:legal": "node tools/generate-legal.mjs",
    "generate:sfx": "node tools/generate-sfx.mjs",
    "build:extension": "node tools/build-extension-zip.mjs",
    "release:check": "node tools/release.mjs --check",
    "lint": "eslint extension web/api web/lib tools --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0"
  }
}
