{
  "name": "알뜰이",
  "short_name": "알뜰이",
  "description": "쿠팡 검색·관련 페이지에서 정렬, 키워드 필터, 표시 항목 조정, 검색 개수 고정을 제공하는 비공식 보조 도구입니다.",
  "version": "2.2.7",
  "manifest_version": 3,
  "minimum_chrome_version": "105",
  "homepage_url": "https://altteuri.vercel.app/",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.coupang.com/*", "https://cart.coupang.com/*", "https://mc.coupang.com/*", "https://altteuri.vercel.app/*"],
  "content_scripts": [
    {
      "matches": ["https://www.coupang.com/*", "https://cart.coupang.com/*", "https://mc.coupang.com/*"],
      "js": ["lib/preset-data.js", "lib/runtime-utils.js", "content/shared-start.js", "content/early.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.coupang.com/*", "https://cart.coupang.com/*", "https://mc.coupang.com/*"],
      "js": [
        "lib/pure-logic.js",
        "lib/settings-defaults.js",
        "lib/runtime-utils.js",
        "content/shared-start.js",
        "content/selectors.js",
        "content/core.js",
        "content/keyword-filter.js",
        "content/sort.js",
        "content/list-size.js",
        "content/element-remover.js",
        "content/page-runtime.js",
        "content/settings-bridge.js",
        "content/onboarding-banner.js",
        "content/boot.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "알뜰이",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/icons/icon48.png"],
      "matches": [
        "https://www.coupang.com/*",
        "https://cart.coupang.com/*",
        "https://mc.coupang.com/*"
      ]
    }
  ]
}
